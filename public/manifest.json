{
  "manifest_version": 3,
  "name": "Productivity Tracker",
  "description": "Track your productive study and work sessions.",
  "version": "1.0.0",

  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "idle"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Productivity Tracker"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}